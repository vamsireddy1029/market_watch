// server.js

const WebSocket = require("ws");
const express = require("express");
const cors = require("cors");
const http = require("http");
const axios = require("axios");

const BinanceConnector = require("./connectors/BinanceConnector");
const DeribitConnector = require("./connectors/DeribitConnector");

const app = express();
app.use(cors());
app.use(express.json());
const server = http.createServer(app);
const wss = new WebSocket.Server({ server });

const connections = {};   // { binance: instance, deribit: instance }
const marketData = {};    // Real-time flat market data (exchange_instrument: data)

// --- Broadcast helper
const broadcast = () => {
  const payload = JSON.stringify({
    type: "marketData",
    data: marketData
  });
  wss.clients.forEach((client) => {
    if (client.readyState === WebSocket.OPEN) {
      client.send(payload);
    }
  });
};

// --- REST API endpoints ---

// Binance instrument info
app.get("/api/binance/exchangeInfo", async (req, res) => {
  try {
    const response = await axios.get("https://eapi.binance.com/eapi/v1/exchangeInfo");
    res.json(response.data);
  } catch (error) {
    res.status(500).json({
      error: error.message,
      details: error.response?.data || "No details",
    });
  }
});

// Deribit instrument info
app.get("/api/deribit/instruments", async (req, res) => {
  try {
    const response = await axios.get("https://www.deribit.com/api/v2/public/get_instruments?currency=BTC");
    res.json(response.data);
  } catch (error) {
    res.status(500).json({
      error: error.message,
      details: error.response?.data || "No details",
    });
  }
});

// Start market data streaming
app.post("/api/start-streaming", async (req, res) => {
  const { exchanges, config } = req.body;
  try {
    for (const exchange of exchanges) {
      // Disconnect if already running
      if (connections[exchange]) {
        connections[exchange].disconnect();
        delete connections[exchange];
        Object.keys(marketData).forEach((key) => {
          if (key.startsWith(`${exchange}_`)) delete marketData[key];
        });
      }

      // Start fresh connection
      if (exchange === "binance") {
        connections.binance = new BinanceConnector((key, data) => {
          marketData[key] = data;
          broadcast();
        });
        await connections.binance.connect(config.binance || {});
      }

      if (exchange === "deribit") {
        connections.deribit = new DeribitConnector((key, data) => {
          marketData[key] = data;
          broadcast();
        });
        await connections.deribit.connect(config.deribit || {});
      }
    }
    res.json({ success: true });
  } catch (err) {
    console.error("Start streaming error:", err);
    res.json({ success: false, error: err.message });
  }
});

// Stop streaming
app.post("/api/stop-streaming", (req, res) => {
  const { exchanges } = req.body;
  exchanges.forEach((exchange) => {
    if (connections[exchange]) {
      connections[exchange].disconnect();
      delete connections[exchange];
    }
    Object.keys(marketData).forEach((key) => {
      if (key.startsWith(`${exchange}_`)) delete marketData[key];
    });
  });
  res.json({ success: true });
});

// --- WebSocket handler
wss.on("connection", (ws) => {
  console.log("Frontend connected");
  ws.send(JSON.stringify({ type: "marketData", data: marketData }));
});

// --- Memory cleanup (if --expose-gc enabled)
setInterval(() => {
  if (global.gc) global.gc();
}, 60000);  // every 1 min

process.on("uncaughtException", (err) => console.error("Uncaught:", err));

// --- Start server
const PORT = process.env.PORT || 8080;
server.listen(PORT, () => {
  console.log(`Server running on port ${PORT}`);
});
